# Auditor configuration. Run the auditor on a different machine than the gateway.
CHAIN_URL=https://your-antelope-node.example
CONTRACT=agentgov
PAYER_ADDRESS=0x...
RPC=https://sepolia.base.org
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# only for --anchor (publish attestations with agentgov::logaudit)
AUDITOR=myauditor
AUDIT_WALLET=agentaudit
AUDIT_WALLET_PW_FILE=/path/to/agentaudit.pw
