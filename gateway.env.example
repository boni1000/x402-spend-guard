# Gateway configuration (no secrets). One gateway per agent.
CHAIN_URL=https://your-antelope-node.example
CONTRACT=agentgov
AGENT=agent1
PERMISSION=gw
GW_WALLET=agentgw
GW_WALLET_PW_FILE=/path/to/agentgw.pw
NETWORK=eip155:84532
RPC=https://sepolia.base.org
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
JOURNAL=journal-agent1.sqlite
# Who signs payments. key (default): PAYER_PRIVATE_KEY in keys.env. mpc: no key on this machine;
# agentgov builds each authorization (requestsig) and an MPC network signs it for the agent's
# address set with agentgov::setpayer. Experimental: the MPC network's interface is not final.
PAYER_MODE=key
